REPLYCANT_DATA_DIR=/var/lib/replycant/data
REPLYCANT_LFS_DIR=/var/lib/replycant/lfs
REPLYCANT_GIT_PORT=8443
REPLYCANT_CA_PORT=8080
# Defaults to <hostname>.local when unset
# REPLYCANT_HOSTNAME=my-server.local

# MagicDNS domain for the tailnet. gitd is reachable at gitd.<this domain>.
# Must differ from the domain headscale is published on.
# REPLYCANT_TAILNET_DOMAIN=replycant.internal

# Cloud discovery is the default: headscale is published at
# <ca-label>.<shard>.<tunnel domain> through the hosted reverse TCP tunnel, so
# nothing has to be forwarded on the router. Both the shard and the relay to
# register with are derived from the CA, so neither needs configuring.
# REPLYCANT_TUNNEL_DOMAIN=tunnel.replycant.com
# Override only when pointing at a relay you run yourself.
# REPLYCANT_TUNNEL_RELAY_ADDR=tunnel.replycant.com:8444

# Manual exposure mode: set this to a hostname you have published yourself,
# forward REPLYCANT_HSPROXY_PORT to this host, start the stack with
# `--scale tunnel-agent=0`, and set REPLYCANT_DISCOVERY_URL= (empty) below.
# gitd then hands the sealed pairing record back to the authorizing device
# to show as a QR, so no hosted service is involved in onboarding at all.
# REPLYCANT_HEADSCALE_URL=https://replycant.example.com:8443

# Where pairing records are published. Set it to empty for manual exposure
# mode; gitd then returns the record instead of publishing it. The record is
# encrypted to the pairing device and authenticated under the secret from its
# QR either way, so the hosted service never sees anything it can read.
# REPLYCANT_DISCOVERY_URL=

# hsproxy is the only externally reachable service. It binds to loopback by
# default so a plain `docker compose up` exposes nothing; manual mode needs
# 0.0.0.0.
# REPLYCANT_HSPROXY_BIND=0.0.0.0
# REPLYCANT_HSPROXY_PORT=8443
