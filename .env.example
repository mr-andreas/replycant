REPLYCANT_DATA_DIR=/var/lib/replycant/data
REPLYCANT_LFS_DIR=/var/lib/replycant/lfs
REPLYCANT_CA_PORT=8080
# The first-device join page listens on every interface by default, so it can
# be opened from another machine on the LAN. It stops handing out join codes
# once the first device has joined. Set 127.0.0.1 to keep it on this host.
# REPLYCANT_CA_BIND=127.0.0.1

# Cloud discovery is the default: headscale is published at
# <ca-label>.<shard>.<tunnel domain> through the hosted reverse TCP tunnel, so
# nothing has to be forwarded on the router. Both the shard and the relay to
# register with are derived from the CA, so neither needs configuring.
# REPLYCANT_TUNNEL_DOMAIN=tunnel.replycant.com
# Override only when pointing at a relay you run yourself.
# REPLYCANT_TUNNEL_RELAY_ADDR=tunnel.replycant.com:8444

# Where pairing records are published. The record is authenticated under the
# secret from the pairing QR, so the hosted service never sees anything it
# can read.
# REPLYCANT_DISCOVERY_URL=https://discovery.replycant.com

# hsproxy's host port. It binds to loopback, so a plain `docker compose up`
# exposes nothing; devices reach it through the hosted relay.
# REPLYCANT_HSPROXY_PORT=8443
