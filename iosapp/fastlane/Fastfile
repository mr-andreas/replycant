default_platform(:ios)
SCREENSHOT_ROOT = File.expand_path("screenshots", __dir__)
FRAMED_SCREENSHOT_ROOT = File.join(SCREENSHOT_ROOT, "framed", "en-US")
README_FRAME_ROOT = File.join(SCREENSHOT_ROOT, "readme")
README_FRAMED_ROOT = File.join(SCREENSHOT_ROOT, "framed", "readme")
RAW_SCREENSHOT_ROOT = File.join(SCREENSHOT_ROOT, "en-US")

SCREENSHOT_DEVICES = [
  "iPhone 17 Pro Max",
  "iPad Pro 13-inch (M5)"
]
SCREENSHOT_IOS_VERSION = "26.2"

platform :ios do
  # Captures screenshot sets, verifies App Store sizes, then frames for marketing.
  lane :screenshots do
    ensure_screenshot_simulator!(SCREENSHOT_DEVICES, SCREENSHOT_IOS_VERSION)
    snapshot(
      devices: SCREENSHOT_DEVICES,
      ios_version: SCREENSHOT_IOS_VERSION
    )
    validate_screenshot_dimensions(RAW_SCREENSHOT_ROOT)
    ensure_frameit_title_font!
    frame_screenshots(
      path: SCREENSHOT_ROOT,
      use_platform: "IOS"
    )
    collect_framed_screenshots!
    validate_screenshot_dimensions(FRAMED_SCREENSHOT_ROOT)
    frame_readme_iphone!
  end

  # Uploads the framed screenshot set to the editable App Store Connect version.
  lane :upload_screenshots do
    deliver(
      api_key: asc_api_key,
      screenshots_path: screenshot_upload_path,
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      # API-key auth cannot inspect IAPs; keep precheck from failing a successful upload.
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  # Uploads repo-managed listing metadata to the editable App Store Connect version.
  lane :upload_metadata do
    assert_metadata_review_info_absent!
    deliver(
      api_key: asc_api_key,
      metadata_path: File.expand_path("metadata", __dir__),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  # Runs capture and upload back-to-back for release submissions.
  lane :release_screenshots do
    screenshots
    upload_screenshots
  end

  # Rebuilds only the README iPhone frame from an existing raw snapshot PNG.
  lane :frame_readme do
    frame_readme_iphone!
  end
end

# Builds an App Store Connect API key object so all upload lanes use one auth path.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    duration: 1200
  )
end

# Fails fast when review notes are mistakenly stored under metadata, because
# App Store Connect requires reviewer contact fields when review info is present.
def assert_metadata_review_info_absent!
  review_info_dir = File.expand_path("metadata/review_information", __dir__)
  return unless Dir.exist?(review_info_dir)

  UI.user_error!(
    "Do not put review information under iosapp/fastlane/metadata/review_information. " \
    "App reviewer contact and notes are entered manually in App Store Connect. " \
    "Use iosapp/fastlane/review_notes.txt as the source text."
  )
end

# Fails fast when the required iOS 26 simulator is missing so snapshot cannot silently
# fall back to an older runtime with a different UI chrome.
def ensure_screenshot_simulator!(device_names, ios_version)
  require "json"

  list = JSON.parse(`xcrun simctl list devices available -j`)
  runtime_key = list.fetch("devices").keys.find do |key|
    key.include?("iOS-#{ios_version.tr('.', '-')}") || key.end_with?("iOS #{ios_version}")
  end

  unless runtime_key
    UI.user_error!(
      "Required iOS #{ios_version} simulator runtime is not installed. " \
      "Install it in Xcode; screenshot capture will not fall back to older iOS versions."
    )
  end

  devices = list.fetch("devices").fetch(runtime_key)
  available = devices.map { |device| device["name"] }.uniq.sort
  missing = device_names.reject do |required_name|
    devices.any? { |device| device["name"] == required_name && device["isAvailable"] != false }
  end
  return if missing.empty?

  UI.user_error!(
    "Required simulator(s) #{missing.join(', ')} were not found on iOS #{ios_version}. " \
    "Available on that runtime: #{available.empty? ? '(none)' : available.join(', ')}. " \
    "Screenshot capture will not fall back to older iOS versions."
  )
end

# Selects framed output when available so upload lanes always use final marketing images.
def screenshot_upload_path
  if File.directory?(FRAMED_SCREENSHOT_ROOT) && Dir.glob(File.join(FRAMED_SCREENSHOT_ROOT, "*.png")).any?
    FRAMED_SCREENSHOT_ROOT
  else
    RAW_SCREENSHOT_ROOT
  end
end

# Supplies a local Title.ttf for Framefile without committing a proprietary font.
# macOS CI and developer machines already ship Arial Bold; we copy it at lane time.
def ensure_frameit_title_font!
  require "fileutils"

  font_path = File.join(SCREENSHOT_ROOT, "fonts", "Title.ttf")
  return if File.file?(font_path)

  candidates = [
    "/System/Library/Fonts/Supplemental/Arial Bold.ttf",
    "/Library/Fonts/Arial Bold.ttf"
  ]
  source = candidates.find { |path| File.file?(path) }
  unless source
    UI.user_error!(
      "frameit needs #{font_path}. Copy a Bold TTF there, or install macOS Arial Bold."
    )
  end

  FileUtils.mkdir_p(File.dirname(font_path))
  FileUtils.cp(source, font_path)
  UI.message("Prepared frameit title font at #{font_path}")
end

# Frames the iPhone timeline for README: black device, no slogan, transparent
# background. Uses a dedicated Framefile so App Store marketing framing stays intact.
def frame_readme_iphone!
  require "fileutils"

  raw = Dir.glob(File.join(RAW_SCREENSHOT_ROOT, "*iPhone*01-timeline.png"))
    .reject { |path| path.end_with?("_framed.png") }
    .min
  UI.user_error!("No raw iPhone 01-timeline screenshot under #{RAW_SCREENSHOT_ROOT}") unless raw

  FileUtils.mkdir_p(README_FRAME_ROOT)
  FileUtils.mkdir_p(README_FRAMED_ROOT)
  Dir.glob(File.join(README_FRAME_ROOT, "*.png")).each { |path| FileUtils.rm_f(path) }

  staged = File.join(README_FRAME_ROOT, File.basename(raw))
  FileUtils.cp(raw, staged)

  frame_screenshots(
    path: README_FRAME_ROOT,
    use_platform: "IOS"
  )

  framed = Dir.glob(File.join(README_FRAME_ROOT, "*_framed.png")).min
  UI.user_error!("README frameit produced no *_framed.png under #{README_FRAME_ROOT}") unless framed

  dest = File.join(README_FRAMED_ROOT, "ios-timeline.png")
  FileUtils.cp(framed, dest)
  UI.success("README iPhone frame written to #{dest}")
end

# Copies frameit *_framed.png outputs into framed/en-US so App Store upload
# has a stable directory of final marketing images.
def collect_framed_screenshots!
  require "fileutils"

  FileUtils.rm_rf(FRAMED_SCREENSHOT_ROOT)
  FileUtils.mkdir_p(FRAMED_SCREENSHOT_ROOT)

  framed = Dir.glob(File.join(RAW_SCREENSHOT_ROOT, "*_framed.png")).sort
  UI.user_error!("frameit produced no *_framed.png under #{RAW_SCREENSHOT_ROOT}") if framed.empty?

  framed.each do |path|
    # deliver prefers unprefixed names; strip the frameit suffix for the upload set.
    dest_name = File.basename(path).sub(/_framed\.png\z/, ".png")
    FileUtils.cp(path, File.join(FRAMED_SCREENSHOT_ROOT, dest_name))
  end
end

# Fails screenshot lanes when output dimensions do not match accepted iPhone or iPad App Store slots.
def validate_screenshot_dimensions(directory = screenshot_upload_path)
  accepted = [
    [1320, 2868], # iPhone 17 Pro Max (6.9") — required App Store baseline
    [2868, 1320],
    [1290, 2796],
    [2796, 1290],
    [1260, 2736],
    [2736, 1260],
    [1206, 2622], # optional 6.3" class
    [2622, 1206],
    [2064, 2752], # iPad Pro 13"
    [2752, 2064],
    [2048, 2732],
    [2732, 2048]
  ]

  screenshots = Dir.glob(File.join(directory, "*.png")).sort
  UI.user_error!("No screenshots found in #{directory}") if screenshots.empty?

  screenshots.each do |screenshot_path|
    info = Actions.sh("sips -g pixelWidth -g pixelHeight \"#{screenshot_path}\"")
    width = info[/pixelWidth:\s*(\d+)/, 1].to_i
    height = info[/pixelHeight:\s*(\d+)/, 1].to_i
    next if accepted.include?([width, height])

    UI.user_error!(
      "Invalid screenshot size for #{File.basename(screenshot_path)}: #{width}x#{height}"
    )
  end
end
